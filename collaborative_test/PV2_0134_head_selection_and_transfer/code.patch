+blob = torch.load(Path(a.out).parent/f'{a.dataset}_C_{pick}.pt', map_location='cuda:0', weights_only=True)
+m = Readout(0, pick).cuda().eval(); m.load_state_dict(blob['model'])
+preds = [m.predict(r) for r in ev]
